{
  "expo": {
    "name": "Agent Ultra",
    "slug": "agent-ultra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agent-ultra",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agent.ultra"
    },
    "android": {
      "package": "com.agent.ultra",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "SEND_SMS",
        "CAMERA",
        "USE_BIOMETRIC",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "REQUEST_INSTALL_PACKAGES",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Agent Ultra to use Face ID for authentication"
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Agent Ultra to access your contacts"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Agent Ultra to access the camera"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Agent Ultra to access your photos",
          "savePhotosPermission": "Allow Agent Ultra to save photos"
        }
      ],
      "./plugins/withAgentNative",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
